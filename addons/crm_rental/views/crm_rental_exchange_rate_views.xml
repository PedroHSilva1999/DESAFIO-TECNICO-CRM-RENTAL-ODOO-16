<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_rental_exchange_rate_view_tree" model="ir.ui.view">
        <field name="name">crm.rental.exchange.rate.tree</field>
        <field name="model">crm.rental.exchange.rate</field>
        <field name="arch" type="xml">
            <tree string="Taxas de Cambio" editable="bottom">
                <field name="date"/>
                <field name="rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="crm_rental_exchange_rate_action" model="ir.actions.act_window">
        <field name="name">Taxas de Câmbio USD / KZ</field>
        <field name="res_model">crm.rental.exchange.rate</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registe a taxa de câmbio do dia
            </p>
            <p>
                E usada sempre a ultima taxa com data igual ou anterior a data actual.
            </p>
        </field>
    </record>

    <menuitem id="crm_rental_exchange_rate_menu"
              name="Taxas de Cambio (USD/KZ)"
              parent="crm.crm_menu_config"
              action="crm_rental_exchange_rate_action"
              sequence="20"/>

</odoo>
