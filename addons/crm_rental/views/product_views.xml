<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_rental" model="ir.ui.view">
        <field name="name">product.template.form.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="detailed_type" position="after">
                <field name="rental_ok"/>
            </field>
        </field>
    </record>
    <record id="product_template_search_view_rental" model="ir.ui.view">
        <field name="name">product.template.search.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="consumable" position="after">
                <separator/>
                <filter string="Aluguer" name="rental_ok" domain="[('rental_ok', '=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
