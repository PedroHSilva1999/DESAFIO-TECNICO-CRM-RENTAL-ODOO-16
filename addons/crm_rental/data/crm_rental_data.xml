<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.USD" model="res.currency">
        <field name="active" eval="True"/>
    </record>
    <record id="base.AOA" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">
        <record id="crm_rental_exchange_rate_default" model="crm.rental.exchange.rate">
            <field name="date" eval="time.strftime('%Y-01-01')"/>
            <field name="rate">990.0</field>
            <field name="company_id" eval="False"/>
        </record>

    <record id="ir_cron_crm_rental_overdue_opportunities" model="ir.cron">
        <field name="name">CRM Rental: notificar oportunidades em atraso</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_overdue_opportunities()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    </data>

</odoo>
