<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_rental_line_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.rental.line.wizard.form</field>
        <field name="model">crm.rental.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Periodo de Aluguer">
                <field name="lead_id" invisible="1"/>
                <field name="line_id" invisible="1"/>
                <field name="currency_usd_id" invisible="1"/>
                <field name="currency_kz_id" invisible="1"/>
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="quantity"/>
                        <field name="pricelist_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="days"/>
                    </group>
                </group>
                <group string="Calculo do Aluguer">
                    <group>
                        <field name="price_unit_usd"/>
                        <field name="total_usd"/>
                    </group>
                    <group>
                        <field name="exchange_rate"/>
                        <field name="total_kz"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
